  {
   "id": "do-now-2",
   "label": "Do Now: Question 2",
   "type": "short-answer-validation",
   "validatorId": "y9l26-do-now-2",
   "validatorKey": "y9l26_do_now_2",
   "content": "<h2 class=\"lesson-h2\">Do Now: Arrays</h2><details class=\"lesson-tps\"><summary><span class=\"lesson-tps-steps\">Think <b>&rarr;</b> Pair <b>&rarr;</b> Share</span><span class=\"lesson-tps-q\">Why does the loop go from 1 TO 4?</span><span class=\"lesson-tps-reveal\">Show the answer</span></summary><div class=\"lesson-tps-a\"><p>Marks has 4 elements, at index 1 to index 4.</p></div></details><p class=\"lesson-lead\">From 2.3 Arrays. The array Marks holds the values in the table.</p><div class=\"lesson-do-now-columns\"><div><p style=\"margin:0 0 6px\"><strong>Marks</strong></p><table class=\"donow-table\" style=\"margin:0 0 4px\"><tr><th style=\"padding:5px 12px;text-align:center;font:700 17px var(--font-mono, monospace);text-align:left\">Index</th><td style=\"padding:5px 12px;text-align:center;font:700 17px var(--font-mono, monospace);color:var(--muted)\">1</td><td style=\"padding:5px 12px;text-align:center;font:700 17px var(--font-mono, monospace);color:var(--muted)\">2</td><td style=\"padding:5px 12px;text-align:center;font:700 17px var(--font-mono, monospace);color:var(--muted)\">3</td><td style=\"padding:5px 12px;text-align:center;font:700 17px var(--font-mono, monospace);color:var(--muted)\">4</td></tr><tr><th style=\"padding:5px 12px;text-align:center;font:700 17px var(--font-mono, monospace);text-align:left\">Value</th><td style=\"padding:5px 12px;text-align:center;font:700 17px var(--font-mono, monospace)\">4</td><td style=\"padding:5px 12px;text-align:center;font:700 17px var(--font-mono, monospace)\">9</td><td style=\"padding:5px 12px;text-align:center;font:700 17px var(--font-mono, monospace)\">2</td><td style=\"padding:5px 12px;text-align:center;font:700 17px var(--font-mono, monospace)\">7</td></tr></table><div class=\"lesson-code\"><div class=\"lesson-code-line\">DECLARE Total : INTEGER</div><div class=\"lesson-code-line\">DECLARE Index : INTEGER</div><div class=\"lesson-code-line\">Total &larr; 0</div><div class=\"lesson-code-line\">FOR Index &larr; 1 TO 4</div><div class=\"lesson-code-line\">&nbsp;&nbsp;&nbsp;&nbsp;Total &larr; Total + Marks[Index]</div><div class=\"lesson-code-line\">NEXT Index</div><div class=\"lesson-code-line\">OUTPUT Total</div></div></div><div><div class=\"lesson-exam-card\"><div class=\"lesson-do-now-responses\"><div class=\"lesson-do-now-response\"><label for=\"y9l26-do-now-2-a\">(a) What does OUTPUT Marks[2] output? [1]</label><input id=\"y9l26-do-now-2-a\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"do-now-2-a\" aria-label=\"Do Now: Arrays part a\" autocomplete=\"off\"></div><div class=\"lesson-do-now-response\"><label for=\"y9l26-do-now-2-b\">(b) What does the program on the right output? [1]</label><input id=\"y9l26-do-now-2-b\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"do-now-2-b\" aria-label=\"Do Now: Arrays part b\" autocomplete=\"off\"></div></div><div class=\"lesson-do-now-actions\"><button type=\"button\" class=\"donow-btn\" id=\"y9l26-do-now-2-check\">Check answers</button><strong>Total: 2 marks</strong></div><div id=\"y9l26-do-now-2-feedback\" class=\"pseudocode-feedback\" role=\"status\" aria-live=\"polite\"></div></div></div></div>"
  },
