        },
        {
          "code": "THEN",
          "feedback": "Line 3 must be THEN."
        },
        {
          "code": "PRICE <- 7",
          "feedback": "Line 4 must set Price to 7 for a customer under 12."
        },
        {
          "code": "ELSE",
