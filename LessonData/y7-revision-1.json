 ],
 "validators": {
  "y7r1_do_now": [
   {
    "suffix": "a",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(an?\\s+)?(start\\s*(\\/|or|and)?\\s*end|terminal|terminator|rounded(\\s+box)?)(\\s+(symbol|shape|box))?\\s*$",
     "flags": "i"
    },
    "feedback": "Box 1 is a rounded box: Start/End."
   },
   {
    "suffix": "b",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(an?\\s+)?(process|rectangle)(\\s+(symbol|shape|box))?\\s*$",
     "flags": "i"
    },
    "feedback": "Box 2 is a rectangle: an instruction. It is a process."
   },
   {
    "suffix": "c",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(an?\\s+)?(decision|diamond)(\\s+(symbol|shape|box))?\\s*$",
     "flags": "i"
    },
    "feedback": "Box 3 is a diamond: a question. It is a decision."
   },
   {
    "suffix": "d",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(an?\\s+)?(input\\s*(or|\\/|and)?\\s*output|output|input|sloping|parallelogram)(\\s+(symbol|shape|box))?\\s*$",
     "flags": "i"
    },
    "feedback": "Box 4 is a sloping box: a message. It is input or output."
   }
  ],
  "y7r1_read_check": [
   {
    "suffix": "a",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(box\\s*)?70\\s*(steps?)?\\s*$",
     "flags": "i"
    },
    "feedback": "Add every Move box: 10 + 40 + 20."
   },
   {
    "suffix": "b",
    "pattern": {
     "__regex": true,
     "source": "^\\s*[\"'\\u201c]?\\s*go\\s*[\"'\\u201d]?\\s*[.!]?\\s*$",
     "flags": "i"
    },
    "feedback": "Find the last Say box before End."
   },
   {
    "suffix": "c",
    "pattern": {
     "__regex": true,
     "source": "^\\s*[\"'\\u201c]?\\s*ready\\s*[\"'\\u201d]?\\s*[.!]?\\s*$",
     "flags": "i"
    },
    "feedback": "Find the first Say box after Start."
   }
  ],
  "y7r1_fix": [
   {
    "suffix": "a",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(box\\s*)?2\\s*\\s*$",
     "flags": "i"
    },
    "feedback": "Check each box. Box 2 points to 180. Is 180 right?"
   },
   {
    "suffix": "b",
    "pattern": {
     "__regex": true,
     "source": "^\\s*point\\s+in\\s+direction\\s*:?\\s*90(\\s*degrees?)?\\s*$",
     "flags": "i"
    },
    "feedback": "Facing right is 90. Keep the words Point in direction."
   }
  ],
  "y7r1_loops_check": [
   {
    "suffix": "a",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(box\\s*)?15\\s*(steps?)?\\s*$",
     "flags": "i"
    },
    "feedback": "Count the presses. Each press moves 5 steps."
   },
   {
    "suffix": "b",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(box\\s*)?2\\s*\\s*$",
     "flags": "i"
    },
    "feedback": "Not pressed follows the False arrow. Where does it point?"
   },
   {
    "suffix": "c",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(box\\s*)?180\\s*(degrees?)?\\s*$",
     "flags": "i"
    },
    "feedback": "Up is 0. Down is the opposite way."
   }
  ],
  "y7r1_practice": [
   {
    "suffix": "a",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(is\\s+(the\\s+)?)?left(\\s+arrow)?(\\s+key)?\\s+pressed\\s*\\??\\s*$",
     "flags": "i"
    },
    "feedback": "A is the decision. It asks a question about the left arrow."
   },
   {
    "suffix": "b",
    "pattern": {
     "__regex": true,
     "source": "^\\s*(box\\s*)?[-\\u2212]\\s*90\\s*(degrees?)?\\s*$",
     "flags": "i"
    },
    "feedback": "B is the direction. Right is 90. Left is the opposite way."
   },
   {
    "suffix": "c",
    "pattern": {
