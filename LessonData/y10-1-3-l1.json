   "type": "short-answer-validation",
   "validatorId": "y10-13l1-check-conversion",
   "validatorKey": "y10_1_3_l1_check_conversion",
   "content": "<h2 class=\"lesson-h2\">Your Turn: Several Units</h2><p class=\"lesson-lead\">Use the same method as the walkthrough, one step at a time.</p><div class=\"lesson-exam-card\"><div class=\"lesson-do-now-responses\"><div class=\"lesson-do-now-response\"><label for=\"y10-13l1-check-conversion-a\">(a) Convert 2 KiB to bits. [1]</label><input id=\"y10-13l1-check-conversion-a\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"check-conversion-a\" aria-label=\"Your Turn: Several Units part a\" autocomplete=\"off\"></div><div class=\"lesson-do-now-response\"><label for=\"y10-13l1-check-conversion-b\">(b) Convert 24576 bits to KiB. [1]</label><input id=\"y10-13l1-check-conversion-b\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"check-conversion-b\" aria-label=\"Your Turn: Several Units part b\" autocomplete=\"off\"></div><div class=\"lesson-do-now-response\"><label for=\"y10-13l1-check-conversion-c\">(c) Convert 1 GiB to KiB. [1]</label><input id=\"y10-13l1-check-conversion-c\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"check-conversion-c\" aria-label=\"Your Turn: Several Units part c\" autocomplete=\"off\"></div></div><div class=\"lesson-do-now-actions\"><button type=\"button\" class=\"donow-btn\" id=\"y10-13l1-check-conversion-check\">Check answers</button><strong>Total: 3 marks</strong></div><div id=\"y10-13l1-check-conversion-feedback\" class=\"pseudocode-feedback\" role=\"status\" aria-live=\"polite\"></div></div>"
  },
