{"id":"y7-flowcharts-l3","label":"7CT.01 L3: Selection","steps":[{"id":"do-now","label":"Do Now: Flowchart Symbols","type":"symbol-mastery","containerId":"y7l3-symbol-mastery","lessonTrackingId":"y7-flowcharts-l3","content":"<h2 class=\"lesson-h2\">Do Now</h2><p class=\"lesson-lead\">Match each symbol to its name three times in a row to master it. A wrong answer resets that symbol's count.</p><div class=\"symbol-mastery\" id=\"y7l3-symbol-mastery\"><div class=\"symbol-mastery-progress\" id=\"y7l3-symbol-mastery-progress\"></div><div class=\"symbol-mastery-question\" id=\"y7l3-symbol-mastery-question\"></div><div class=\"symbol-mastery-options\" id=\"y7l3-symbol-mastery-options\"></div><div class=\"symbol-mastery-complete\" id=\"y7l3-symbol-mastery-complete\" hidden></div></div>"},{"id":"title","label":"Selection","content":"<div class=\"lesson-title-slide\"><p class=\"lesson-title-kicker\">Computational Thinking</p><h2 class=\"lesson-h2\">Selection</h2><p>Year 7, 7CT.01 L3</p></div>"},{"id":"teacher-talk-1","label":"Recap: Decisions","type":"stepper","stepperId":"y7l3-stepper-1","stepperKey":"y7l3_decision_recap","content":"<h2 class=\"lesson-h2\">Recap: Decisions</h2><p class=\"lesson-lead\">Before adding anything new, a quick reminder of what a decision does.</p><div id=\"y7l3-stepper-1\" class=\"lesson-stepper\"></div>"},{"id":"activity-1","label":"Explore: Combining Conditions","type":"condition-explorer","containerId":"y7l3-explorer","content":"<h2 class=\"lesson-h2\">Explore: Combining Conditions</h2><p class=\"lesson-lead\">Sometimes one decision is not enough. Try the switches below and see what changes.</p><div class=\"condition-explorer\" id=\"y7l3-explorer\"><div class=\"condition-explorer-switches\" id=\"y7l3-explorer-switches\"></div><div class=\"condition-explorer-gate\" id=\"y7l3-explorer-gate\"></div><div class=\"condition-explorer-result\" id=\"y7l3-explorer-result\"></div></div>"},{"id":"teacher-talk-2","label":"AND, OR and NOT","type":"stepper","stepperId":"y7l3-stepper-2","stepperKey":"y7l3_logic_gates","content":"<h2 class=\"lesson-h2\">AND, OR and NOT</h2><p class=\"lesson-lead\">Three words that combine or change conditions.</p><div id=\"y7l3-stepper-2\" class=\"lesson-stepper\"></div>"},{"id":"activity-2","label":"Match the Result","type":"click-match","containerId":"y7l3-match","items":[{"id":"and-true","left":"Up = 1 AND Right = 1","right":"Moves diagonally up-right"},{"id":"and-false","left":"Up = 1 AND Right = 0","right":"Does not move diagonally"},{"id":"or-true","left":"Up = 0 OR Right = 1","right":"The camera pans"},{"id":"or-false","left":"Up = 0 OR Right = 0","right":"The camera stays still"},{"id":"not-true","left":"NOT Up, Up = 0","right":"The sprite stands still"},{"id":"not-false","left":"NOT Up, Up = 1","right":"The sprite is not standing still"}],"content":"<h2 class=\"lesson-h2\">Match the Result</h2><p class=\"lesson-lead\">Click a card on the left, then click the result it leads to on the right.</p><div class=\"icontrol-match\" id=\"y7l3-match\"><svg class=\"icontrol-match-svg\" aria-hidden=\"true\"><defs><marker id=\"icontrol-arrow\" markerWidth=\"8\" markerHeight=\"8\" refX=\"6\" refY=\"4\" orient=\"auto\"><path d=\"M0,0 L8,4 L0,8 Z\"></path></marker></defs></svg><div class=\"icontrol-match-col click-match-left\"></div><div class=\"icontrol-match-col click-match-right\"></div></div><div class=\"icontrol-match-status\" id=\"y7l3-match-status\" role=\"status\" aria-live=\"polite\"></div>"},{"id":"teacher-talk-3","label":"Comparing Numbers","type":"stepper","stepperId":"y7l3-stepper-3","stepperKey":"y7l3_comparisons","content":"<h2 class=\"lesson-h2\">Comparing Numbers</h2><p class=\"lesson-lead\">A decision can also compare two numbers.</p><div id=\"y7l3-stepper-3\" class=\"lesson-stepper\"></div>"},{"id":"activity-3","label":"Explore: Comparing Numbers","type":"number-comparer","containerId":"y7l3-comparer","content":"<h2 class=\"lesson-h2\">Explore: Comparing Numbers</h2><p class=\"lesson-lead\">Change the numbers and the operator. Watch the result.</p><div class=\"number-comparer\" id=\"y7l3-comparer\"><div class=\"number-comparer-numbers\" id=\"y7l3-comparer-numbers\"></div><div class=\"condition-explorer-gate\" id=\"y7l3-comparer-op\"></div><div class=\"condition-explorer-result\" id=\"y7l3-comparer-result\"></div></div>"},{"id":"activity-4","label":"Quick Fire: Comparisons","type":"truth-quiz","containerId":"y7l3-quiz","items":[{"prompt":"7 > 3","correct":true},{"prompt":"3 > 7","correct":false},{"prompt":"4 < 9","correct":true},{"prompt":"9 < 4","correct":false},{"prompt":"5 = 5","correct":true},{"prompt":"5 = 8","correct":false},{"prompt":"5 <> 8","correct":true},{"prompt":"5 <> 5","correct":false}],"content":"<h2 class=\"lesson-h2\">Quick Fire: Comparisons</h2><p class=\"lesson-lead\">Pick 1 for True, 0 for False.</p><div class=\"symbol-mastery\" id=\"y7l3-quiz\"><div class=\"symbol-mastery-question\" id=\"y7l3-quiz-question\"></div><div class=\"symbol-mastery-options\" id=\"y7l3-quiz-options\"></div><div class=\"symbol-mastery-complete\" id=\"y7l3-quiz-complete\" hidden></div></div>"},{"id":"formative","label":"Check Your Understanding","content":"<h2 class=\"lesson-h2\">Check Your Understanding</h2><p class=\"lesson-lead\">Questions to ask around the room:</p><ul class=\"lesson-facts\"><li>What does a decision check?</li><li>When is AND equal to 1?</li><li>When is OR equal to 1?</li><li>What does NOT do to 1 and 0?</li><li>What does &gt; check? What does = check?</li></ul>"},{"id":"teacher-talk-4","label":"Predicting the Outcome","type":"stepper","stepperId":"y7l3-stepper-4","stepperKey":"y7l3_predict_outcomes","content":"<h2 class=\"lesson-h2\">Predicting the Outcome</h2><p class=\"lesson-lead\">A flowchart with two decisions, followed one step at a time.</p><div id=\"y7l3-stepper-4\" class=\"lesson-stepper\"></div>"},{"id":"activity-5","label":"Trace the Path","type":"flowchart-trace","containerId":"y7l3-trace","content":"<h2 class=\"lesson-h2\">Trace the Path</h2><p class=\"lesson-lead\">This is the flowchart from the last slide. For each scenario, predict what the sprite does.</p><div class=\"branch-diagram\" id=\"y7l3-trace-diagram\"></div><div class=\"symbol-mastery\" id=\"y7l3-trace\"><div class=\"symbol-mastery-question\" id=\"y7l3-trace-scenario\"></div><div class=\"symbol-mastery-options\" id=\"y7l3-trace-options\"></div><div class=\"symbol-mastery-complete\" id=\"y7l3-trace-complete\" hidden></div></div>"},{"id":"plenary","label":"Plenary: AND, OR, NOT","type":"short-answer-validation","validatorId":"y7l3-plenary","validatorKey":"y7l3_plenary","content":"<h2 class=\"lesson-h2\">Plenary: AND, OR, NOT</h2><p class=\"lesson-lead\">Answer without using the earlier slides.</p><div class=\"lesson-exam-card\"><h3>Question 1</h3><div class=\"lesson-do-now-responses\"><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-a\">(a) State when AND is equal to 1. [1]</label><input id=\"y7l3-plenary-a\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-a\" aria-label=\"Plenary part a\" autocomplete=\"off\"></div><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-b\">(b) State when OR is equal to 1. [1]</label><input id=\"y7l3-plenary-b\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-b\" aria-label=\"Plenary part b\" autocomplete=\"off\"></div><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-c\">(c) State what NOT does to 1 and 0. [1]</label><input id=\"y7l3-plenary-c\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-c\" aria-label=\"Plenary part c\" autocomplete=\"off\"></div></div><div class=\"lesson-do-now-actions\"><button type=\"button\" class=\"donow-btn\" id=\"y7l3-plenary-check\">Check answers</button><strong>Total: 3 marks</strong></div><div id=\"y7l3-plenary-feedback\" class=\"pseudocode-feedback\" role=\"status\" aria-live=\"polite\"></div></div>"},{"id":"plenary-2","label":"Plenary: One Key Pressed","type":"short-answer-validation","validatorId":"y7l3-plenary-2","validatorKey":"y7l3_plenary_2","content":"<h2 class=\"lesson-h2\">Plenary: One Key Pressed</h2><p class=\"lesson-lead\">A flowchart moves a sprite diagonally only when Up AND Right are both pressed. Only the Up key is pressed.</p><div class=\"lesson-exam-card\"><h3>Question 2</h3><div class=\"lesson-do-now-responses\"><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-2-a\">(a) State whether the first decision is 1 or 0. [1]</label><input id=\"y7l3-plenary-2-a\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-2-a\" aria-label=\"Plenary 2 part a\" autocomplete=\"off\"></div><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-2-b\">(b) State what the sprite does. [1]</label><input id=\"y7l3-plenary-2-b\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-2-b\" aria-label=\"Plenary 2 part b\" autocomplete=\"off\"></div></div><div class=\"lesson-do-now-actions\"><button type=\"button\" class=\"donow-btn\" id=\"y7l3-plenary-2-check\">Check answers</button><strong>Total: 2 marks</strong></div><div id=\"y7l3-plenary-2-feedback\" class=\"pseudocode-feedback\" role=\"status\" aria-live=\"polite\"></div></div>"},{"id":"plenary-3","label":"Plenary: Neither Key Pressed","type":"short-answer-validation","validatorId":"y7l3-plenary-3","validatorKey":"y7l3_plenary_3","content":"<h2 class=\"lesson-h2\">Plenary: Neither Key Pressed</h2><p class=\"lesson-lead\">A game pauses when Space OR Enter is pressed. Neither key is pressed.</p><div class=\"lesson-exam-card\"><h3>Question 3</h3><div class=\"lesson-do-now-responses\"><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-3-a\">(a) State whether Space OR Enter is 1 or 0. [1]</label><input id=\"y7l3-plenary-3-a\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-3-a\" aria-label=\"Plenary 3 part a\" autocomplete=\"off\"></div><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-3-b\">(b) State whether the game pauses. [1]</label><input id=\"y7l3-plenary-3-b\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-3-b\" aria-label=\"Plenary 3 part b\" autocomplete=\"off\"></div><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-3-c\">(c) Explain your answer using the word OR. [1]</label><input id=\"y7l3-plenary-3-c\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-3-c\" aria-label=\"Plenary 3 part c\" autocomplete=\"off\"></div></div><div class=\"lesson-do-now-actions\"><button type=\"button\" class=\"donow-btn\" id=\"y7l3-plenary-3-check\">Check answers</button><strong>Total: 3 marks</strong></div><div id=\"y7l3-plenary-3-feedback\" class=\"pseudocode-feedback\" role=\"status\" aria-live=\"polite\"></div></div>"},{"id":"plenary-4","label":"Plenary: Comparisons","type":"short-answer-validation","validatorId":"y7l3-plenary-4","validatorKey":"y7l3_plenary_4","content":"<h2 class=\"lesson-h2\">Plenary: Comparisons</h2><p class=\"lesson-lead\">A score of 12 is compared with a target of 20.</p><div class=\"lesson-exam-card\"><h3>Question 4</h3><div class=\"lesson-do-now-responses\"><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-4-a\">(a) State the result of Score &gt; Target. [1]</label><input id=\"y7l3-plenary-4-a\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-4-a\" aria-label=\"Plenary 4 part a\" autocomplete=\"off\"></div><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-4-b\">(b) State the result of Score &lt; Target. [1]</label><input id=\"y7l3-plenary-4-b\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-4-b\" aria-label=\"Plenary 4 part b\" autocomplete=\"off\"></div><div class=\"lesson-do-now-response\"><label for=\"y7l3-plenary-4-c\">(c) State the result of Score = Target. [1]</label><input id=\"y7l3-plenary-4-c\" class=\"pseudocode-output-input lesson-exam-answer\" data-answer-kind=\"short\" data-answer-id=\"plenary-4-c\" aria-label=\"Plenary 4 part c\" autocomplete=\"off\"></div></div><div class=\"lesson-do-now-actions\"><button type=\"button\" class=\"donow-btn\" id=\"y7l3-plenary-4-check\">Check answers</button><strong>Total: 3 marks</strong></div><div id=\"y7l3-plenary-4-feedback\" class=\"pseudocode-feedback\" role=\"status\" aria-live=\"polite\"></div></div>"}],"validators":{"y7l3_plenary":[{"suffix":"a","pattern":{"__regex":true,"source":"^\\s*(when\\s+)?(all|both|every)\\b.{0,30}$","flags":"i"},"feedback":"AND needs every part to be 1."},{"suffix":"b","pattern":{"__regex":true,"source":"^\\s*(when\\s+)?(at\\s*least\\s*)?(one|either)\\b.{0,30}$","flags":"i"},"feedback":"OR needs at least one part to be 1."},{"suffix":"c","pattern":{"__regex":true,"source":"^\\s*(it\\s+)?(swaps?|flips?|reverses?|inverts?)\\b.{0,30}$","flags":"i"},"feedback":"It swaps 1 and 0."}],"y7l3_plenary_2":[{"suffix":"a","pattern":{"__regex":true,"source":"^\\s*0\\s*$","flags":""},"feedback":"Right is not pressed, so Up AND Right pressed? is 0."},{"suffix":"b","pattern":{"__regex":true,"source":"^\\s*(it\\s+)?(does\\s*not|will\\s*not|won'?t)\\s+move\\s+diagonally\\.?\\s*$","flags":"i"},"feedback":"It does not move diagonally."}],"y7l3_plenary_3":[{"suffix":"a","pattern":{"__regex":true,"source":"^\\s*0\\s*$","flags":""},"feedback":"Neither key is pressed, so both parts are 0."},{"suffix":"b","pattern":{"__regex":true,"source":"^\\s*(no|false)\\b.{0,20}$","flags":"i"},"feedback":"No, the game does not pause."},{"suffix":"c","pattern":{"__regex":true,"source":"^\\s*.{0,50}\\bat\\s*least\\s*one\\b.{0,50}$","flags":"i"},"feedback":"OR needs at least one part to be 1, and neither key is pressed."}],"y7l3_plenary_4":[{"suffix":"a","pattern":{"__regex":true,"source":"^\\s*0\\s*$","flags":""},"feedback":"12 is not greater than 20."},{"suffix":"b","pattern":{"__regex":true,"source":"^\\s*1\\s*$","flags":""},"feedback":"12 is less than 20."},{"suffix":"c","pattern":{"__regex":true,"source":"^\\s*0\\s*$","flags":""},"feedback":"12 does not equal 20."}]},"pseudocodeValidators":{}}