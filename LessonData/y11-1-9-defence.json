olid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace);border:2px dashed var(--bad, var(--danger, #b42318));color:var(--bad, var(--danger, #b42318))\"></td><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace);border:2px dashed var(--bad, var(--danger, #b42318));color:var(--bad, var(--danger, #b42318))\"></td></tr><tr><th style=\"padding:6px 4px;min-width:38px;text-align:center;font-weight:700;font-size:13px;color:var(--muted);background:var(--surface-2);border:1px solid var(--line-strong);text-align:right;padding-right:10px;min-width:0\">After</th><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace);background:var(--brand-soft);color:var(--brand-dark);outline:3px solid var(--brand);outline-offset:-3px\">0</td><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace);background:var(--brand-soft);color:var(--brand-dark);outline:3px solid var(--brand);outline-offset:-3px\">0</td><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace)\">1</td><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace)\">1</td><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace);color:var(--muted-2)\">0</td><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace)\">1</td><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace);color:var(--muted-2)\">0</td><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace)\">1</td><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace);border:2px dashed var(--bad, var(--danger, #b42318));color:var(--bad, var(--danger, #b42318))\">1</td><td style=\"padding:4px 3px;min-width:38px;text-align:center;border:1px solid var(--line-strong);height:30px;font:700 19px var(--font-mono, monospace);border:2px dashed var(--bad, var(--danger, #b42318));color:var(--bad, var(--danger, #b42318))\">0</td></tr></table>"
