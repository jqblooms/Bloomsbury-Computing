    "context": "The array Scores is already filled: Scores[1] = 7, Scores[2] = 2, Scores[3] = 9, Scores[4] = 4. Complete the trace table.",
    "code": [
     "DECLARE Total : INTEGER",
     "DECLARE Index : INTEGER",
     "Total = 0",
     "for Index in range(1, 5):",
     "    Total = Total + Scores[Index]",
     "print(Total)"
